# Provisioning is pending inspection of the actual Pi's OS, kernel, Docker,
# Hailo and camera packages, including package sources and exact versions.
# These runtime pins are intentionally unset and are not a full package inventory.
# Filling them in does not enable provisioning or create a success marker.
DOCKER_ENGINE_VERSION=
DOCKER_CLI_VERSION=
DOCKER_COMPOSE_VERSION=

